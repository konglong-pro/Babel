<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="BabelWindow"
    Title="Babel Launcher"
    Width="1000"
    Height="720"
    MinWidth="860"
    MinHeight="620"
    WindowStartupLocation="CenterScreen"
    Background="#FBF8EF"
    FontFamily="Segoe UI"
    FontSize="14"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    AutomationProperties.Name="Babel application launcher">
    <Window.Resources>
        <DrawingBrush
            x:Key="PaperBrush"
            TileMode="Tile"
            Viewport="0,0,28,28"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FBF8EF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,28,28" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#101E1B18">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="5,5" RadiusX="0.55" RadiusY="0.55" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFC" />
            <Setter Property="BorderBrush" Value="#1D1B18" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        Color="#1D1B18"
                        BlurRadius="0"
                        Direction="315"
                        ShadowDepth="5"
                        Opacity="1" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="Background" Value="#FFFFFC" />
            <Setter Property="Foreground" Value="#1D1B18" />
            <Setter Property="BorderBrush" Value="#1D1B18" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#FFF19A" />
                                <Setter Property="Foreground" Value="#1D1B18" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#F6DA64" />
                                <Setter Property="Foreground" Value="#1D1B18" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#2E75D4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.34" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="PrimaryButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FFF19A" />
        </Style>

        <Style
            x:Key="StopButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#EF2B2D" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="AppCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="274" />
            <Setter Property="Height" Value="126" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.HelpText" Value="Select this notebook, then choose Open" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="SelectionChrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionChrome" Property="Background" Value="#40FFF19A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionChrome" Property="Background" Value="#FFF19A" />
                                <Setter TargetName="SelectionChrome" Property="BorderBrush" Value="#1D1B18" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SelectionChrome" Property="BorderBrush" Value="#2E75D4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="128" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="34,24,34,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image
                        x:Name="BrandLogo"
                        Width="42"
                        Height="42"
                        Margin="0,0,12,0"
                        Stretch="Uniform"
                        AutomationProperties.Name="Babel green book logo" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#A7C080"
                        FontFamily="Arial"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Babel" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0">
                    <StackPanel.Effect>
                        <DropShadowEffect
                            Color="#1D1B18"
                            BlurRadius="0"
                            Direction="315"
                            ShadowDepth="3"
                            Opacity="1" />
                    </StackPanel.Effect>
                    <TextBlock
                        Foreground="#FFF19A"
                        FontFamily="Arial Black"
                        FontSize="38"
                        FontWeight="Black"
                        LineHeight="40"
                        Text="Open a Notebook" />
                </StackPanel>

            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="34,0,34,14"
            Padding="18,14,18,12"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="4,0,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Foreground="#EF2B2D"
                        FontFamily="Arial"
                        FontSize="11"
                        FontWeight="Bold"
                        Text="N  O  T  E  B  O  O  K  S" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="#777068"
                        FontSize="11"
                        Text="SELECT ONE TO OPEN" />
                </Grid>

                <ListBox
                    x:Name="AppsGrid"
                    Grid.Row="1"
                    Margin="-6,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource AppCardItemStyle}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="Single"
                    AutomationProperties.Name="Registered notebook cards"
                    AutomationProperties.HelpText="Use the arrow keys to select a notebook, then choose Open">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18,14">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                        <Setter Property="Background" Value="#EEE9DE" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Stopped">
                                                <Setter Property="Background" Value="#EEE9DE" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                <Setter Property="Background" Value="#C8DDF8" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                <Setter Property="Background" Value="#BCEBCF" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Unhealthy">
                                                <Setter Property="Background" Value="#FFD0D0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="External">
                                                <Setter Property="Background" Value="#D9D2F3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Foreground="#1D1B18"
                                        FontFamily="Arial"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Text="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}" />
                                    <Border
                                        Grid.Row="1"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Padding="9,4"
                                        Background="#FFFFFC"
                                        BorderBrush="#1D1B18"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <TextBlock
                                            Foreground="#1D1B18"
                                            FontFamily="Arial"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Text="{Binding Status}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2" Margin="4,8,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="OpenSelectedButton"
                        MinWidth="220"
                        Margin="0,0,12,0"
                        Content="OPEN (_O)"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.Name="Open selected notebook"
                        AutomationProperties.HelpText="Starts the selected notebook when needed, verifies its identity, and opens it in the default browser" />
                    <Button
                        x:Name="MinimizeToTrayButton"
                        Grid.Column="1"
                        Width="190"
                        Margin="0"
                        Content="MINIMIZE TO TRAY (_M)"
                        Style="{StaticResource ActionButtonStyle}"
                        AutomationProperties.Name="Hide the launcher in the Windows notification area" />
                </Grid>
            </Grid>
        </Border>

        <Expander
            x:Name="AdvancedExpander"
            Grid.Row="2"
            Margin="34,0,34,12"
            Padding="0"
            IsExpanded="False"
            AutomationProperties.Name="Advanced and diagnostic controls"
            AutomationProperties.HelpText="Contains service controls, shortcut settings, verification, and complete session logs">
            <Expander.Header>
                <TextBlock
                    Foreground="#1D1B18"
                    FontFamily="Arial"
                    FontSize="11"
                    FontWeight="Bold"
                    Text="ADVANCED / DIAGNOSTICS" />
            </Expander.Header>
            <Border
                Margin="0,8,0,0"
                Padding="14"
                Background="#1D1B18"
                BorderBrush="#1D1B18"
                BorderThickness="2"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                        <Button
                            x:Name="StartAllButton"
                            Width="150"
                            Margin="0,0,8,7"
                            Content="START ALL (_A)"
                            Style="{StaticResource ActionButtonStyle}"
                            AutomationProperties.Name="Start all notebooks" />
                        <Button
                            x:Name="StopSelectedButton"
                            Width="150"
                            Margin="0,0,8,7"
                            Content="STOP SELECTED (_T)"
                            Style="{StaticResource StopButtonStyle}"
                            AutomationProperties.Name="Stop the selected notebook managed by this window" />
                        <Button
                            x:Name="StopAllButton"
                            Width="150"
                            Margin="0,0,8,7"
                            Content="STOP ALL"
                            Style="{StaticResource StopButtonStyle}"
                            AutomationProperties.Name="Stop all notebooks managed by this window" />
                        <Button
                            x:Name="VerifyButton"
                            Width="150"
                            Margin="0,0,8,7"
                            Content="VERIFY ALL (_V)"
                            Style="{StaticResource ActionButtonStyle}"
                            AutomationProperties.Name="Verify all notebooks" />
                        <Button
                            x:Name="ShortcutsButton"
                            Width="150"
                            Margin="0,0,0,7"
                            Content="SHORTCUTS (_K)"
                            Style="{StaticResource ActionButtonStyle}"
                            AutomationProperties.Name="Configure global application shortcuts" />
                    </WrapPanel>
                    <Grid Grid.Row="1" Margin="2,0,2,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="#FFF19A"
                            FontFamily="Arial"
                            FontSize="11"
                            FontWeight="Bold"
                            Text="C  O  M  P  L  E  T  E    S  E  S  S  I  O  N    L  O  G" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="#BBB3A9"
                            FontSize="10"
                            Text="READ ONLY" />
                    </Grid>
                    <TextBox
                        x:Name="LogTextBox"
                        Grid.Row="2"
                        Padding="12,7"
                        Background="Transparent"
                        BorderBrush="#777068"
                        BorderThickness="1"
                        Foreground="#F7EFA8"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        FontSize="12"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        AutomationProperties.Name="Complete read-only session log" />
                </Grid>
            </Border>
        </Expander>

        <Border Grid.Row="3" Background="#EF2B2D" Padding="34,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" Fill="#FFF19A" />
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="SemiBold"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                        Text="Loading the application registry..." />
                </StackPanel>
                <TextBlock
                    x:Name="WorkerText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="White"
                    FontFamily="Consolas"
                    FontSize="11"
                    FontWeight="Bold"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                    Text="WORKER / IDLE" />
            </Grid>
        </Border>
    </Grid>
</Window>
