<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="BabelWindow"
    Title="Babel"
    Width="1280"
    Height="860"
    MinWidth="860"
    MinHeight="620"
    WindowStartupLocation="CenterScreen"
    Background="#FBF8EF"
    FontFamily="Segoe UI"
    FontSize="14"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    AutomationProperties.Name="Babel desktop">
    <Window.Resources>
        <DrawingBrush
            x:Key="PaperBrush"
            TileMode="Tile"
            Viewport="0,0,28,28"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FBF8EF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,28,28" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#101E1B18">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="5,5" RadiusX="0.55" RadiusY="0.55" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFC" />
            <Setter Property="BorderBrush" Value="#1D1B18" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        Color="#1D1B18"
                        BlurRadius="0"
                        Direction="315"
                        ShadowDepth="5"
                        Opacity="1" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="Background" Value="#FFFFFC" />
            <Setter Property="Foreground" Value="#1D1B18" />
            <Setter Property="BorderBrush" Value="#1D1B18" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#FFF19A" />
                                <Setter Property="Foreground" Value="#1D1B18" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#F6DA64" />
                                <Setter Property="Foreground" Value="#1D1B18" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#2E75D4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.34" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="PrimaryButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FFF19A" />
        </Style>

        <Style
            x:Key="StopButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#EF2B2D" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="AppGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8292E" />
            <Setter Property="BorderBrush" Value="#1D1B18" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="AppGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#E4DED0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Foreground" Value="#1D1B18" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF9D8" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFF19A" />
                    <Setter Property="Foreground" Value="#1D1B18" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AppGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="DesktopTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#262A23" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E8EBDD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#DAE4C9" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Chrome" Property="Background" Value="#EEF3E5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#527F35" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DesktopTabCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource DesktopTabButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#666B61" />
        </Style>
        <Style x:Key="DesktopAppTabStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAF9F3" />
            <Setter Property="BorderBrush" Value="#DCDDD3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="active">
                    <Setter Property="Background" Value="#EEF3E5" />
                    <Setter Property="BorderBrush" Value="#8FA775" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="10,6" Background="#F8F8F1" BorderBrush="#D8DCCF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DesktopHomeButton" Grid.Column="0" Style="{StaticResource DesktopTabButtonStyle}"
                            Tag="active" Margin="0,0,10,0" Padding="10,5" ToolTip="Babel · All notebooks"
                            AutomationProperties.Name="Babel home">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="DesktopBrandLogo" Width="32" Height="28" Margin="0,0,8,0" Stretch="Uniform" />
                            <TextBlock Text="Babel" Foreground="#91AC6C" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DesktopShortcutsButton" Grid.Column="2" Content="Shortcuts"
                            Style="{StaticResource DesktopTabButtonStyle}" Margin="8,0,0,0"
                            Foreground="#666B61" ToolTip="Customize shortcuts" />
                    <ScrollViewer x:Name="DesktopTabScroller" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" Focusable="False">
                        <StackPanel x:Name="DesktopAppTabs" Orientation="Horizontal" />
                    </ScrollViewer>
                </Grid>
                <TextBlock x:Name="DesktopStatusText" Grid.Row="1" Margin="4,3,0,0" FontSize="11"
                           Foreground="#5E5952" Text="Apps · Start, open and manage notebooks"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>
        <Grid x:Name="DesktopSurface" Grid.Row="1">
    <Grid x:Name="LauncherPanel" Background="{StaticResource PaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="*" />
            <RowDefinition Height="96" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="34,16,34,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image
                        x:Name="BrandLogo"
                        Width="38"
                        Height="34"
                        Margin="0,0,12,0"
                        Stretch="Uniform"
                        AutomationProperties.Name="Babel green book logo" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#A7C080"
                        FontFamily="Arial"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Babel" />
                </StackPanel>

                <StackPanel Margin="0,8,0,0">
                    <StackPanel.Effect>
                        <DropShadowEffect
                            Color="#1D1B18"
                            BlurRadius="0"
                            Direction="315"
                            ShadowDepth="3"
                            Opacity="1" />
                    </StackPanel.Effect>
                    <TextBlock
                        Foreground="#FFF19A"
                        FontFamily="Arial Black"
                        FontSize="36"
                        FontWeight="Black"
                        LineHeight="40"
                        Text="Attention Iteration" />
                </StackPanel>

            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="34,0,34,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="198" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,20,0"
                Padding="20,16,20,14"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="#EF2B2D"
                            FontFamily="Arial"
                            FontSize="11"
                            FontWeight="Bold"
                            Text="R  E  G  I  S  T  E  R  E  D    A  P  P  S" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="#777068"
                            FontSize="11"
                            Text="SELECT A NOTEBOOK" />
                    </Grid>

                    <DataGrid
                        x:Name="AppsGrid"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        ColumnHeaderStyle="{StaticResource AppGridHeaderStyle}"
                        CellStyle="{StaticResource AppGridCellStyle}"
                        RowStyle="{StaticResource AppGridRowStyle}"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        RowHeaderWidth="0"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        GridLinesVisibility="None"
                        AutomationProperties.Name="Registered application list"
                        AutomationProperties.HelpText="Use the arrow keys to select an application">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="APPLICATION" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding Logo}" Width="26" Height="26" Margin="0,0,10,0" Stretch="Uniform" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PORT" Binding="{Binding Port}" Width="70" />
                            <DataGridTemplateColumn Header="STATUS" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Padding="8,4"
                                            BorderBrush="#1D1B18"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EEE9DE" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Stopped">
                                                            <Setter Property="Background" Value="#EEE9DE" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                            <Setter Property="Background" Value="#C8DDF8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                            <Setter Property="Background" Value="#BCEBCF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Unhealthy">
                                                            <Setter Property="Background" Value="#FFD0D0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="External">
                                                            <Setter Property="Background" Value="#D9D2F3" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                Foreground="#1D1B18"
                                                FontFamily="Arial"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Text="{Binding Status}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="14"
                Style="{StaticResource CardStyle}">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            Margin="1,0,0,4"
                            Foreground="#EF2B2D"
                            FontFamily="Arial"
                            FontSize="11"
                            FontWeight="Bold"
                            Text="C  O  M  M  A  N  D  S" />
                        <TextBlock
                            Margin="1,0,0,8"
                            Foreground="#777068"
                            FontSize="11"
                            Text="Keys: 1-0 / Up-Down / Enter / Delete / Esc | Alt+A / Alt+V / Alt+K"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="OpenSelectedButton"
                            Content="OPEN"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Open the selected notebook; keyboard Enter returns to the tray after a successful open."
                            AutomationProperties.Name="Open selected notebook" />
                        <Button
                            x:Name="StartAllButton"
                            Content="START ALL (_A)"
                            Style="{StaticResource ActionButtonStyle}"
                            ToolTip="Start all stopped notebooks in one managed session after independent workers are stopped; stop it with STOP ALL."
                            AutomationProperties.Name="Start all applications in one managed session" />
                        <Button
                            x:Name="StopSelectedButton"
                            Content="STOP SELECTED"
                            Style="{StaticResource StopButtonStyle}"
                            AutomationProperties.Name="Stop the selected notebook worker created by OPEN" />
                        <Button
                            x:Name="StopAllButton"
                            Content="STOP ALL"
                            Style="{StaticResource StopButtonStyle}"
                            AutomationProperties.Name="Stop all notebook workers including the Start All session" />
                        <Button
                            x:Name="VerifyButton"
                            Content="VERIFY ALL (_V)"
                            Style="{StaticResource ActionButtonStyle}"
                            AutomationProperties.Name="Verify all applications" />
                        <Button
                            x:Name="ShortcutsButton"
                            Content="SHORTCUTS (_K)"
                            Style="{StaticResource ActionButtonStyle}"
                            AutomationProperties.Name="Configure launcher hotkey and web application shortcuts" />
                        <Button
                            x:Name="MinimizeToTrayButton"
                            Content="MINIMIZE TO TRAY"
                            Margin="0"
                            Style="{StaticResource ActionButtonStyle}"
                            ToolTip="Keep the launcher and global hotkey running in the Windows notification area; Escape does the same."
                            AutomationProperties.Name="Hide the launcher in the Windows notification area" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Expander
            x:Name="AdvancedExpander"
            Grid.Row="2"
            IsExpanded="True">
            <Expander.Template>
                <ControlTemplate TargetType="Expander">
                    <ContentPresenter
                        x:Name="ContentSite"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Expander.Template>
            <Border
                Margin="34,0,34,16"
                Background="#1D1B18"
                BorderBrush="#1D1B18"
                BorderThickness="2"
                CornerRadius="12">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="15,11,15,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Foreground="#FFF19A"
                        FontFamily="Arial"
                        FontSize="11"
                        FontWeight="Bold"
                        Text="S  E  S  S  I  O  N    L  O  G" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="#999188"
                        FontSize="10"
                        Text="LIVE OUTPUT / COMPLETE SESSION" />
                </Grid>
                <TextBox
                    x:Name="LogTextBox"
                    Grid.Row="1"
                    Margin="4,0,4,4"
                    Padding="12,7"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#F7EFA8"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="12"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    AutomationProperties.Name="Complete read-only session log" />
                </Grid>
            </Border>
        </Expander>

        <Border Grid.Row="3" Background="#EF2B2D" Padding="34,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,10,0" Fill="#FFF19A" />
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="SemiBold"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                        Text="Loading the application registry..." />
                </DockPanel>
                <TextBlock
                    x:Name="WorkerText"
                    Grid.Column="1"
                    MaxWidth="260"
                    VerticalAlignment="Center"
                    Foreground="White"
                    FontFamily="Consolas"
                    FontSize="11"
                    FontWeight="Bold"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                    Text="WORKER / IDLE" />
            </Grid>
        </Border>
    </Grid>
        </Grid>
    </Grid>
</Window>
