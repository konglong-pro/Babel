<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="BabelWindow"
    Title="Babel 启动器"
    Width="820"
    Height="610"
    MinWidth="680"
    MinHeight="500"
    WindowStartupLocation="CenterScreen"
    Background="#F4F6F8"
    FontFamily="Segoe UI"
    FontSize="14"
    TextOptions.TextFormattingMode="Display"
    AutomationProperties.Name="Babel 应用启动器">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#173B57" Padding="22,18">
            <StackPanel>
                <TextBlock
                    Foreground="White"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="Babel" />
                <TextBlock
                    Margin="0,5,0,0"
                    Foreground="#DCE8F0"
                    Text="统一启动、停止和验证本地笔记应用" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,18,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DataGrid
                x:Name="AppsGrid"
                Grid.Column="0"
                Margin="0,0,18,0"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                GridLinesVisibility="Horizontal"
                AlternatingRowBackground="#F7FAFC"
                RowHeight="38"
                AutomationProperties.Name="已注册应用列表"
                AutomationProperties.HelpText="使用方向键选择一个应用">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="应用" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="90" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1" Width="136">
                <Button
                    x:Name="StartSelectedButton"
                    Content="启动选中 (_S)"
                    IsDefault="True"
                    AutomationProperties.Name="启动选中的应用" />
                <Button
                    x:Name="StartAllButton"
                    Content="启动全部 (_A)"
                    AutomationProperties.Name="启动全部应用" />
                <Button
                    x:Name="StopButton"
                    Content="停止 (_T)"
                    AutomationProperties.Name="停止本窗口启动的应用" />
                <Button
                    x:Name="OpenButton"
                    Content="打开页面 (_O)"
                    AutomationProperties.Name="在浏览器打开选中的应用" />
                <Button
                    x:Name="VerifyButton"
                    Content="验证全部 (_V)"
                    AutomationProperties.Name="验证全部应用" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Margin="20,0,20,14" BorderBrush="#CDD6DE" BorderThickness="1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Padding="10,8"
                    Background="#EAF0F4"
                    FontWeight="SemiBold"
                    Text="启动日志" />
                <TextBox
                    x:Name="LogTextBox"
                    Grid.Row="1"
                    Padding="10,8"
                    BorderThickness="0"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="12"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    AutomationProperties.Name="启动日志，只读" />
            </Grid>
        </Border>

        <StatusBar Grid.Row="3" Padding="12,5" Background="#E3E9EE">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="正在载入应用注册表…" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="WorkerText" Text="worker：空闲" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
