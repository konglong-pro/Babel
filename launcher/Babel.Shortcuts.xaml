<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="BabelShortcutsWindow"
    Title="Babel Shortcuts"
    Width="720"
    Height="640"
    MinWidth="620"
    MinHeight="560"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="#FBF8EF"
    FontFamily="Segoe UI"
    FontSize="14"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    AutomationProperties.Name="Babel global shortcut settings">
    <Window.Resources>
        <Style x:Key="ShortcutButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Background" Value="#FFFFFC" />
            <Setter Property="Foreground" Value="#1D1B18" />
            <Setter Property="BorderBrush" Value="#1D1B18" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#FFF19A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#F6DA64" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#2E75D4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShortcutHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFFFFC" />
            <Setter Property="Foreground" Value="#EF2B2D" />
            <Setter Property="BorderBrush" Value="#1D1B18" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ShortcutCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#E4DED0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="#FFFFFC" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                Foreground="#EF2B2D"
                FontFamily="Arial"
                FontSize="11"
                FontWeight="Bold"
                Text="G  L  O  B  A  L    S  H  O  R  T  C  U  T  S" />
            <TextBlock
                Margin="0,8,0,0"
                Foreground="#1D1B18"
                FontFamily="Arial Black"
                FontSize="28"
                FontWeight="Black"
                Text="Keyboard commands" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Margin="0,10,0,14"
            Foreground="#5E5952"
            FontSize="12"
            TextWrapping="Wrap"
            Text="Select a shortcut field, then press the complete key combination. Shortcuts require Ctrl or Alt; Escape is the only unmodified key allowed." />

        <Border
            Grid.Row="2"
            Background="#FFFFFC"
            BorderBrush="#1D1B18"
            BorderThickness="2"
            CornerRadius="9">
            <DataGrid
                x:Name="ShortcutGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeRows="False"
                ColumnHeaderStyle="{StaticResource ShortcutHeaderStyle}"
                CellStyle="{StaticResource ShortcutCellStyle}"
                HeadersVisibility="Column"
                IsReadOnly="True"
                RowHeaderWidth="0"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                GridLinesVisibility="None"
                AutomationProperties.Name="Global shortcut command list">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="COMMAND" Binding="{Binding Label}" Width="*" />
                    <DataGridTemplateColumn Header="SHORTCUT" Width="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox
                                    x:Name="ShortcutCaptureBox"
                                    Tag="{Binding Id}"
                                    Text="{Binding Shortcut}"
                                    IsReadOnly="True"
                                    Cursor="Hand"
                                    Padding="9,5"
                                    Background="#FBF8EF"
                                    BorderBrush="#1D1B18"
                                    BorderThickness="1"
                                    FontFamily="Consolas"
                                    FontWeight="Bold"
                                    AutomationProperties.Name="{Binding Label, StringFormat={}{0} shortcut}"
                                    AutomationProperties.HelpText="Focus this field and press a complete shortcut" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,14">
            <TextBlock
                x:Name="ShortcutErrorText"
                MinHeight="18"
                Foreground="#C22026"
                FontSize="12"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Assertive" />
            <TextBlock
                x:Name="ShortcutStatusText"
                Margin="0,5,0,0"
                Foreground="#5E5952"
                FontSize="12"
                TextWrapping="Wrap"
                Text="Saved shortcuts take effect after you reload open application pages."
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="RestoreDefaultsButton"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Margin="0"
                Content="RESTORE DEFAULTS"
                Style="{StaticResource ShortcutButtonStyle}"
                AutomationProperties.Name="Restore default shortcuts" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                    x:Name="CancelShortcutsButton"
                    Content="CANCEL"
                    IsCancel="True"
                    Style="{StaticResource ShortcutButtonStyle}"
                    AutomationProperties.Name="Cancel shortcut changes" />
                <Button
                    x:Name="SaveShortcutsButton"
                    Content="SAVE"
                    IsDefault="True"
                    Background="#FFF19A"
                    Style="{StaticResource ShortcutButtonStyle}"
                    AutomationProperties.Name="Save global shortcuts" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
